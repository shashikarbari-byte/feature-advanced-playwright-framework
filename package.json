{
  "name": "playwright-ecommerce-automation",
  "version": "1.0.0",
  "description": "Portfolio-grade Playwright UI and API automation framework for an e-commerce application.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "lint": "tsc --noEmit",
    "test:ci": "playwright test",
    "test:ui:chromium": "playwright test tests/ui --project=chromium",
    "test:ui:firefox": "playwright test tests/ui --project=firefox"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
